# Copy to docker/production/.env before: docker compose -f compose.yml up -d --build

POSTGRES_DB=basis
POSTGRES_USER=basis
POSTGRES_PASSWORD=change-me

# Host port for nginx (SPA + /api proxy)
BASIS_HTTP_PORT=8080

# After first boot, in 系统 → 设置 → 登录, set BOTH to your public site (same origin):
#   API 公网 URL = Web 应用 Origin = http://localhost:8080   (or https://app.example.com)
# OAuth callbacks will show as http://localhost:8080/api/auth/...
