# Vite desktop mode (ADR 0004). API port is OS-assigned (profile port 0).
# Electron `desktop/npm run dev` sets VITE_BASIS_API_URL from basis.ready / gateway.ready.
# Standalone: run `uv run basis serve --profile desktop`, read `port` from ready JSON, then:
#   VITE_BASIS_API_URL=http://127.0.0.1:<port> npm run dev:desktop
# Renderer: http://127.0.0.1:3001 (see web package.json dev:desktop)
VITE_BASIS_AUTH_REQUIRED=false
VITE_BASIS_DESKTOP=true
