# 进程 1：Basis API（Python，内嵌 semantica SDK）
BASIS_HOST=127.0.0.1
BASIS_PORT=8090
BASIS_DATA_DIR=./data
# 留空使用 SQLite；生产环境可设为：
# BASIS_DATABASE_URL=postgresql://basis:basis@127.0.0.1:5432/basis
BASIS_DB_POOL_SIZE=10
BASIS_DB_MAX_OVERFLOW=20
BASIS_DB_POOL_TIMEOUT_SECONDS=30
BASIS_MCP_MAX_INFLIGHT=32
BASIS_MCP_TIMEOUT_SECONDS=60
# 未版本化 /api/*（默认关闭；调试旧客户端可设为 1）
# BASIS_LEGACY_API_ENABLED=1
# 测试/调试：同步执行 ingest，避免后台线程（生产勿开）
# BASIS_INGEST_INLINE=1
# HTTP 拉取连接器定时 tick（秒）；0=关闭
# BASIS_HTTP_POLL_TICK_SECONDS=60
# 结构化 JSON 日志（仅 basis.* logger；生产/采集侧可开）
# BASIS_LOG_JSON=1
# 请求上限（可选，见 basis.limits.RuntimeLimits）
# BASIS_GRAPH_PAGE_MAX_NODES=200
# BASIS_GRAPH_PAGE_MAX_EDGES=400
# BASIS_CHUNK_SEARCH_MAX_LIMIT=50
# BASIS_IMPORT_MAX_BYTES=52428800
# BASIS_UPLOAD_MAX_BYTES=52428800
# BASIS_INGEST_MAX_INFLIGHT=4
# BASIS_INGEST_MAX_PENDING=32
# BASIS_PROCESSING_JOB_TIMEOUT_SECONDS=600
# BASIS_INGEST_MAX_EXTRACT_CHARS=2000000
# BASIS_INGEST_MAX_CHUNKS=2000
# BASIS_INGEST_EXTRACT_TIMEOUT_SECONDS=300

# 进程 2：管理界面（仅静态 + 开发代理）
BASIS_API_URL=http://127.0.0.1:8090

# 登录 / OAuth：系统 → 设置 → 登录。
# Docker 生产（Nginx 反代 /api，同域）：docker/production/README.md
