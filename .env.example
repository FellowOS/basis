# 进程 1：Sema API（Python，内嵌 Semantica SDK）
SEMA_HOST=127.0.0.1
SEMA_PORT=8090
SEMA_DATA_DIR=./data
# 留空使用 SQLite；生产环境可设为：
# SEMA_DATABASE_URL=postgresql://sema:sema@127.0.0.1:5432/sema
SEMA_DB_POOL_SIZE=10
SEMA_DB_MAX_OVERFLOW=20
SEMA_DB_POOL_TIMEOUT_SECONDS=30
SEMA_MCP_MAX_INFLIGHT=32
SEMA_MCP_TIMEOUT_SECONDS=60
# 测试/调试：同步执行 ingest，避免后台线程（生产勿开）
# SEMA_INGEST_INLINE=1
# HTTP 拉取连接器定时 tick（秒）；0=关闭
# SEMA_HTTP_POLL_TICK_SECONDS=60

# 进程 2：管理界面（仅静态 + 开发代理）
SEMA_API_URL=http://127.0.0.1:8090
