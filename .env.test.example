# Connector integration tests (pytest loads this via tests/integration_env.py).
# Copy to .env.test in the repo root (gitignored) and fill in secrets.
#
#   cp .env.test.example .env.test
#
# Postgres — match BASIS_DATABASE_URL in .env (compose.postgres.yml maps host 5432).
# If omitted here, pytest copies BASIS_DATABASE_URL from .env after load.
BASIS_TEST_POSTGRES_URL=postgresql://basis:basis@127.0.0.1:5432/basis
# Optional: fixed writable DB instead of ephemeral CREATEDB per run:
# BASIS_TEST_POSTGRES_EXTERNAL_URL=postgresql://basis:basis@127.0.0.1:5432/basis
#
# GitHub — PAT must reach api.github.com; owner/repo must be accessible to that token.
# Issues list: read access. Issues create (optional): Issues read/write on fine-grained PAT,
# or classic ``repo`` scope. Use a disposable repo if you do not want test issues in production.
BASIS_TEST_GITHUB_TOKEN=
BASIS_TEST_GITHUB_OWNER=your-github-login
BASIS_TEST_GITHUB_REPO=your-repo-with-issues
#
# Override env file path:
# BASIS_TEST_ENV_FILE=/path/to/custom.env.test
